# Secrets -- never commit
config.json
.env
*.key

# Per-site working folders and state created by the script
saved_urls_*.json
pending_jobs_*.json
url_list_*.json
crawl_state_*.json
firecrawl_map_*.json
file_sizes_*.json
skipped_too_big_*.json
timeline_*.json
timeline_*.txt
urls_*.txt
urls.txt
urls.csv
url.csv
url_list.txt

# ...except the three files of a run that are handed to the record workflow (see incoming/README.md).
# Nothing else is let through: config.json and the other state files stay ignored.
!incoming/*/saved_urls_*.json
!incoming/*/url_list_*.json
!incoming/*/timeline_*.json

